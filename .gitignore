node_modules
dist
.turbo
*.local

# Tauri / Rust
target
apps/desktop/src-tauri/gen

# pnpm
.pnpm-store

# TypeScript incremental build info
*.tsbuildinfo

# Local Yahoo-Finance candle cache for backtest sweeps (TRA-181, TRA-266)
packages/server/.cache/
packages/backtest/data/*
# Pinned fixtures committed for deterministic CI tests (TRA-1579)
!packages/backtest/data/btc-usd.4h.json

# Server runtime output — never commit user data, logs, or QA scratch (TRA-689)
packages/server/data/
packages/server/logs/
packages/server/.qa-payload.json

# Compiler output emitted IN PLACE beside a TS source (TRA-1660).
#
# `tsc <file>` ignores tsconfig.json — given explicit file arguments it never reads
# the config, so outDir/noEmit are silently dropped and it emits next to the input.
# The resulting `src/foo.js` then WINS module resolution over `src/foo.ts`, and the
# test suite exercises the stale compiled copy. If that copy is an older *passing*
# build, the suite goes GREEN against code you are not shipping.
#
# These trees are 100% TypeScript (zero tracked .js), so ignoring the emit is safe.
# NOTE: .gitignore only stops a stray `git add -A` from committing it — it does NOT
# stop the shadowing. `pnpm check:stale-js` is the check that actually blocks that,
# and it also covers scripts/, which is deliberately not ignored here because
# hand-written .js is legitimate there.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
apps/desktop/src/**/*.js
apps/desktop/src/**/*.js.map
apps/desktop/src/**/*.d.ts
apps/desktop/src/**/*.d.ts.map
!apps/desktop/src/vite-env.d.ts
