{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/engine" },
    { "path": "./packages/agents" },
    { "path": "./packages/backtest" },
    { "path": "./apps/desktop" }
  ]
}
