{
  "name": "trading-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop tauri build",
    "render-build": "pnpm --filter @trading-app/shared build && pnpm --filter @trading-app/engine build && pnpm --filter @trading-app/backtest build && pnpm --filter @trading-app/server build && pnpm --filter desktop vite:build",
    "server:dev": "pnpm --filter @trading-app/server dev",
    "server:build": "pnpm --filter @trading-app/server build",
    "server:start": "pnpm --filter @trading-app/server start",
    "web:dev": "concurrently \"pnpm server:dev\" \"pnpm --filter desktop vite:dev\"",
    "web:build": "pnpm -r --filter './packages/**' build && pnpm --filter desktop vite:build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm --filter @trading-app/shared build && pnpm --filter @trading-app/engine build && pnpm --filter @trading-app/backtest build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=9"
  }
}
